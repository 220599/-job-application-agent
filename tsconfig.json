{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@jaa/database": ["packages/database"],
      "@jaa/database/*": ["packages/database/*"],
      "@jaa/ai": ["packages/ai"],
      "@jaa/ai/*": ["packages/ai/*"],
      "@jaa/browser": ["packages/browser"],
      "@jaa/browser/*": ["packages/browser/*"],
      "@jaa/ats": ["packages/ats"],
      "@jaa/ats/*": ["packages/ats/*"],
      "@jaa/core": ["packages/core"],
      "@jaa/core/*": ["packages/core/*"],
      "@jaa/greenhouse": ["packages/greenhouse"],
      "@jaa/greenhouse/*": ["packages/greenhouse/*"],
      "@jaa/lever": ["packages/lever"],
      "@jaa/lever/*": ["packages/lever/*"],
      "@jaa/resume": ["packages/resume"],
      "@jaa/resume/*": ["packages/resume/*"],
      "@jaa/matching": ["packages/matching"],
      "@jaa/matching/*": ["packages/matching/*"],
      "@jaa/shared": ["packages/shared"],
      "@jaa/shared/*": ["packages/shared/*"]
    }
  },
  "include": [
    "apps/*/src/**/*",
    "packages/*/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".next"
  ]
}
