# Database
DB_USER=jaa_user
DB_PASSWORD=jaa_password
DB_NAME=jaa_dev
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# API
API_HOST=localhost
API_PORT=3001
API_URL=http://${API_HOST}:${API_PORT}

# Web
WEB_HOST=localhost
WEB_PORT=3000
WEB_URL=http://${WEB_HOST}:${WEB_PORT}

# AI Provider
# Options: openai, anthropic, gemini, groq
AI_PROVIDER=openai
AI_MODEL=gpt-4-turbo-preview
OPENAI_API_KEY=sk_test_your_key_here

# Browser
PLAYWRIGHT_CHROMIUM_DOWNLOAD_HOST=https://playwright.azureedge.net
BROWSER_HEADLESS=true

# Phase 15A mock submission boundary (TEST/DEV ONLY).
# Submission is refused unless this is "true", always refused in production,
# and only ever targets loopback mock ATS servers.
JAA_ALLOW_MOCK_SUBMISSION=false

# Phase 15B controlled REAL Greenhouse submission (server-only capability).
# Disabled by default. Only when this is exactly "true" may the server
# submit to a real, recognized GREENHOUSE application form (public URL
# policy enforced; Lever stays mock-only; no client can ever set this).
# Keep this unset/false on any shared or production deployment.
JAA_REAL_GREENHOUSE_SUBMISSION_ENABLED=false

# Authorized target for the gated real-submission suite only
# (npm run test:greenhouse:real). Must be a Greenhouse application URL you
# are authorized to submit to. When empty, the suite fails closed: it
# skips/refuses explicitly and never falls back to any public job posting.
JAA_REAL_GREENHOUSE_TEST_URL=

# Employer-issued Greenhouse Job Board API key (the authorized, challenge-
# free submission channel). Created by the employer's Greenhouse admin on
# their "API Credentials" page (Job Board API type). Server-side secret:
# never exposed to the browser, never logged. Leave empty and submissions
# fall back to the application form path (the fallback reason is recorded
# on the attempt; never silent).
JAA_GREENHOUSE_JOB_BOARD_API_KEY=

# TEST-ONLY override of the Job Board API base URL (local mock fixtures).
# Accepted ONLY for loopback hosts; any other base is refused by the SSRF
# guard before a connection is opened. Leave empty in normal operation -
# the documented https://boards-api.greenhouse.io host is used.
JAA_GREENHOUSE_JOB_BOARD_API_BASE=

# Phase 15C controlled REAL Lever submission (server-only capability).
# Disabled by default. Only when this is exactly "true" may the server
# submit to a real, recognized LEVER application form (public URL policy
# enforced; no client can ever set this). Keep this unset/false on any
# shared or production deployment.
JAA_REAL_LEVER_SUBMISSION_ENABLED=false

# Employer-issued Lever API key (the authorized, challenge-free submission
# channel documented at hire.lever.co/developer/documentation, "Apply to a
# posting"). Created by a Super Admin of the employer's Lever account on
# Settings -> Integrations -> API Credentials. Server-side secret: never
# exposed to the browser, never logged. Leave empty and submissions fall
# back to the application form path (the fallback reason is recorded on
# the attempt; never silent).
JAA_LEVER_API_KEY=

# TEST-ONLY override of the Lever API base URL (local mock fixtures).
# Accepted ONLY for loopback hosts; any other base is refused by the SSRF
# guard before a connection is opened. Leave empty in normal operation -
# the documented https://api.lever.co host is used.
JAA_LEVER_API_BASE=

# Environment
NODE_ENV=development
LOG_LEVEL=debug

# Application
APP_SECRET=your_secret_key_here_change_in_production
SESSION_TIMEOUT=24h

# Email (optional, for future use)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Sentry (optional, for future observability)
SENTRY_DSN=
