{
  "name": "@jaa/api",
  "version": "0.1.0",
  "description": "REST API backend",
  "private": true,
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "set TS_NODE_PROJECT=../../tsconfig.json && set API_PORT=4001 && node --import tsx/esm src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@jaa/core": "*",
    "@jaa/database": "*",
    "@jaa/shared": "*",
    "@types/multer": "^2.3.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "multer": "^2.4.0",
    "undici": "^8.11.2",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "eslint": "^8.54.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.0"
  }
}
